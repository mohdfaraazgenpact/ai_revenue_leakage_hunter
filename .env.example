# Copy to .env (never commit .env). SYNTHETIC DATA ONLY with any provider.
# claude_code = Claude via the Claude Code CLI (claude -p) on your signed-in licence, no API key
# gemini      = free Google Gemini API (needs GEMINI_API_KEY)
LLM_PROVIDER=claude_code
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: full path to claude.exe if it is not on PATH (the VS Code extension copy is found automatically)
CLAUDE_CODE_CLI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# readwrite (default) | readonly (offline demo, cache only) | off
LLM_CACHE_MODE=readwrite
# rule | llm
EXTRACTOR=rule
